# Configuracao do WAF ModSecurity v3 + OWASP CRS
# Altera estes valores para testar diferentes perfis (ex: BLOCKING_PARANOIA=2)
# e depois reinicia o contentor: docker compose up -d waf

MODSEC_RULE_ENGINE=On
BLOCKING_PARANOIA=1
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4

# Auditoria (Fase 5 do ModSecurity)
MODSEC_AUDIT_ENGINE=RelevantOnly
MODSEC_AUDIT_LOG_FORMAT=JSON
MODSEC_AUDIT_LOG=/var/log/modsecurity/audit.log
MODSEC_AUDIT_LOG_PARTS=ABIJDEFHZ
